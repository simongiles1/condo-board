# Copy to `.env.local` and fill in values.

GEMINI_API_KEY=

# DeepSeek API (contact highlight extraction option: DeepSeek V4 Flash 0731)
# Contact extract disables V4 thinking so max_tokens is not eaten by reasoning.
DEEPSEEK_API_KEY=
# Optional override; defaults to https://api.deepseek.com
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com

# Postgres connection string — local and Coolify must use the same Supabase
# session-pooler URI (sslmode=require, aws-0-us-west-2). Compose Postgres on
# localhost:5433 is rollback-only after the one-Postgres cutover.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
# Docker Compose app container: docker-entrypoint defaults COND_BOARD_POSTGRES_URL
# to the compose `db` service. Coolify sets COND_BOARD_POSTGRES_URL to this same
# Supabase URI. Entrypoint copies it onto DATABASE_URL at runtime.

# Per-project Supabase CLI (npm run supabase — not the global Cursor MCP).
# Do not run `supabase login`; that writes a PAT to the OS keyring / ~/.supabase
# and would follow you into other repos.
# PAT: https://supabase.com/dashboard/account/tokens on the Condo Board account.
# Must start with sbp_ (not the anon or service_role API keys).
SUPABASE_ACCESS_TOKEN=
# Dashboard → Project Settings → General → Reference ID
SUPABASE_PROJECT_REF=
# Database password shown at project creation (CLI link / db dump).
SUPABASE_DB_PASSWORD=
# Private Storage bucket for Docling / vision / assembled markdown (not original PDFs).
SUPABASE_STORAGE_BUCKET=extract-artifacts
# Server-only Storage API key (Dashboard → Project Settings → API → service_role).
# Used to hydrate disk misses and dual-write new Docling/vision markdown.
# Never expose to the browser. Data API can stay off; Storage REST is separate.
SUPABASE_SERVICE_ROLE_KEY=

# Docling sidecar (Extraction lab A/B + local text-page backfill).
# Start with: npm run docling:sidecar
# Backfill text-route pages: npm run backfill:docling (--all / --dry-run / --max-pages=N)
# Requires local .venv-docling with docling + services/docling-sidecar/requirements.txt
# DOCLING_SIDECAR_URL=http://127.0.0.1:5001

# IBM Docling for watsonx (Extraction backfill toggle: IBM API vs local sidecar).
# Sign up: https://www.ibm.com/products/docling → start the 30-day trial (5,000 pages).
# In the IBM SaaS console: Instances → your Docling instance → workbench → API keys.
# Copy the Service URL and API key. $4 per 1,000 pages after the trial ($0.004/page).
# Extra trials: set DOCLING_IBM_URL_2 / DOCLING_IBM_API_KEY_2 (and _3 / _4).
# A 402 usage_limit_exceeded response rotates to the next key automatically.
# If URL_N is omitted, key N reuses DOCLING_IBM_URL. Hosted IBM instances
# usually need their own Service URL.
# DOCLING_IBM_URL=https://your-instance.dcls.saas.ibm.com
# DOCLING_IBM_API_KEY=
# DOCLING_IBM_URL_2=
# DOCLING_IBM_API_KEY_2=
# DOCLING_IBM_URL_3=
# DOCLING_IBM_API_KEY_3=
# DOCLING_IBM_URL_4=
# DOCLING_IBM_API_KEY_4=
# Optional override if IBM changes list price (default 0.004)
# DOCLING_IBM_USD_PER_PAGE=0.004
# Parallel IBM convert jobs (default 4, max 8). Also used as the document
# worker pool size for IBM / vision-only backfill.
# DOCLING_IBM_CONCURRENCY=4

# Cloudflare Workers AI — attachment Markdown conversion (toMarkdown REST API)
# Required for Extraction lab text path (PDFs/Office → .md). Page vision uses
# Gemini only and does not need these.
# Account ID: Cloudflare dashboard → Workers & Pages → Overview (right sidebar),
#   or `npx wrangler whoami`.
# API token: https://dash.cloudflare.com/profile/api-tokens
#   Create Token → custom token with Account → Workers AI → Edit (or Workers Scripts Edit).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: SQLite file when running db:migrate-from-sqlite
# SQLITE_DATABASE_PATH=./data/app.db

# Bulk extract: how many email threads run LLM passes in parallel (Tier B).
# Registry ingest stays serial and is deferred off the LLM workers. Default 5. Max 16.
# BULK_EXTRACT_THREAD_CONCURRENCY=5

# Project identity review (Entities → Projects → Duplicates).
# Character budget for pass-2 email packs. Default 300000. Min 20000.
# PROJECT_IDENTITY_REVIEW_PASS2_MAX_CHARS=300000

# Management-report scan (Entities → Projects). Character budget per PDF
# after slicing to the management-report section. Default 40000. Min 8000.
# After extraction, unmatched headings are AI-matched onto registry cards
# using name + aliases + year + contractor + location + equipment (not fuzzy
# spelling). Re-match topics with AI reuses stored headings; no extra env.
# BOARD_REPORT_SCAN_MAX_CHARS=40000

# Local UI dev: stop bulk extract / Gmail scheduler (and harvest-after-sync)
# and Telegram long-poll from auto-starting on `npm run dev`. Also skips the
# org/project fingerprint warmup that otherwise freezes the Node process for
# minutes. Production must leave this unset so ingest + Telegram keep running.
# Chat ids are stored per user in Profile.
# DISABLE_BACKGROUND_WORKERS=true

# Faster entities list (uses mentionWeight instead of live verified email counts)
# SKIP_LIVE_MENTION_COUNTS=true

# Optional Gemini model overrides
GEMINI_MODEL_MINUTES=gemini-3.7-flash
GEMINI_MODEL_TODOS=gemini-3.7-flash
GEMINI_MODEL_OMISSIONS=gemini-3.7-flash
GEMINI_MODEL_EMAIL_ANALYSIS=gemini-3.7-flash
# Tier 2 page vision (pending attachment_document_pages → Gemini multimodal)
GEMINI_MODEL_PAGE_VISION=gemini-3.7-flash

# Optional output token limits (Gemini 3 models use thinking tokens unless disabled in code)
GEMINI_MAX_OUTPUT_TOKENS_MINUTES=65536
GEMINI_MAX_OUTPUT_TOKENS_TODOS=8192
GEMINI_MAX_OUTPUT_TOKENS_OMISSIONS=65536
GEMINI_MAX_OUTPUT_TOKENS_EMAIL_ANALYSIS=65536
GEMINI_MAX_OUTPUT_TOKENS_PAGE_VISION=8192

# Page vision worker (on-demand: POST /api/email/attachments/vision-batch or npm run page-vision)
# PAGE_VISION_BATCH_SIZE=4
# PAGE_VISION_MAX_ATTEMPTS=3
# PAGE_VISION_STALE_PROCESSING_MS=900000
# Pause after a Gemini RPM 429 before retrying the same document (ms).
# PAGE_VISION_RATE_LIMIT_BACKOFF_MS=15000
# PAGE_VISION_RATE_LIMIT_MAX_ROUNDS=4

# Phase 2 — Gmail API (Google Cloud OAuth 2.0 credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3010/api/email/oauth/callback
NEXT_PUBLIC_APP_URL=http://localhost:3010

# Encrypt stored Gmail refresh tokens (use a long random string)
GMAIL_TOKEN_ENCRYPTION_KEY=

# Optional: dedicated condo mailbox address (OAuth login hint + mismatch checks)
GMAIL_DEDICATED_EMAIL=

# Telegram HITL bot (ambiguous contact identity / affiliation needs_review).
# Create a bot with @BotFather. Chat ids are set per user in Profile, not here.
# TELEGRAM_BOT_TOKEN=
# Production webhook (skip long-poll). Secret is sent as X-Telegram-Bot-Api-Secret-Token.
# Do not set these locally — local + prod cannot both long-poll the same bot.
# TELEGRAM_WEBHOOK_URL=https://condo-board.helixautomation.dev/api/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=

# Optional auth for shared/hosted access (disabled by default locally)
AUTH_ENABLED=false
AUTH_ALLOW_SIGNUP=false
# When app_users is empty, /signup still works once and creates a super_admin.
# After that, set AUTH_ALLOW_SIGNUP=true to invite more users (they get role user).
AUTH_SECRET=change-me-to-a-long-random-string
# Seed users on first login setup: email:password[:full name[:role]], comma-separated
# Full name is split into first and last on the first space.
# Roles: super_admin, admin, user (first seeded user defaults to super_admin; later signups get user)
AUTH_USERS=you@example.com:your-password,board@example.com:their-password

# Password reset email (required on production; optional locally — dev shows link in UI + server log)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Condo Board <noreply@yourdomain.com>
