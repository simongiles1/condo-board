# Copy to `.env.local` and fill in values.

GEMINI_API_KEY=

# Postgres connection string (local dev / npm run dev outside Docker)
DATABASE_URL=postgresql://condo:condo@localhost:5433/condo_board
# Docker Compose / Coolify: Postgres is set via COND_BOARD_POSTGRES_URL in docker-compose.yml.
# Coolify may also show DATABASE_URL — ignore it; entrypoints overwrite DATABASE_URL at runtime.

# Optional: SQLite file when running db:migrate-from-sqlite
# SQLITE_DATABASE_PATH=./data/app.db

# Optional Gemini model overrides
GEMINI_MODEL_MINUTES=gemini-2.5-flash
GEMINI_MODEL_TODOS=gemini-2.5-flash
GEMINI_MODEL_OMISSIONS=gemini-2.5-flash
GEMINI_MODEL_EMAIL_ANALYSIS=gemini-2.5-flash

# Optional output token limits (Gemini 3 models use thinking tokens unless disabled in code)
GEMINI_MAX_OUTPUT_TOKENS_MINUTES=65536
GEMINI_MAX_OUTPUT_TOKENS_TODOS=8192
GEMINI_MAX_OUTPUT_TOKENS_OMISSIONS=65536
GEMINI_MAX_OUTPUT_TOKENS_EMAIL_ANALYSIS=65536

# Phase 2 — Gmail API (Google Cloud OAuth 2.0 credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3010/api/email/oauth/callback
NEXT_PUBLIC_APP_URL=http://localhost:3010

# Encrypt stored Gmail refresh tokens (use a long random string)
GMAIL_TOKEN_ENCRYPTION_KEY=

# Optional: dedicated condo mailbox address (OAuth login hint + mismatch checks)
GMAIL_DEDICATED_EMAIL=

# Optional auth for shared/hosted access (disabled by default locally)
AUTH_ENABLED=false
AUTH_ALLOW_SIGNUP=false
# When app_users is empty, /signup still works once and creates a super_admin.
# After that, set AUTH_ALLOW_SIGNUP=true to invite more users (they get role user).
AUTH_SECRET=change-me-to-a-long-random-string
# Seed users on first login setup: email:password[:full name[:role]], comma-separated
# Full name is split into first and last on the first space.
# Roles: super_admin, admin, user (first seeded user defaults to super_admin; later signups get user)
AUTH_USERS=you@example.com:your-password,board@example.com:their-password

# Password reset email (required on production; optional locally — dev shows link in UI + server log)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Condo Board <noreply@yourdomain.com>
